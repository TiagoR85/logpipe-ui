@page "/"
@inject ILogSearchClient Client
@inject NavigationManager Nav

<PageTitle>logpipe — search</PageTitle>

<h1>Log search</h1>

<div class="mb-3 d-flex gap-2">
    <input class="form-control" placeholder="fuzzy query" data-testid="search-input"
           @bind="_q" @bind:event="oninput" @onkeydown="OnKeyDown" />
    <select class="form-select" style="max-width: 12rem" data-testid="level-filter" @bind="_level">
        <option value="">All levels</option>
        @foreach (var level in Levels)
        {
            <option value="@level">@level</option>
        }
    </select>
    <input class="form-control" placeholder="service" style="max-width: 12rem"
           data-testid="service-filter" @bind="_service" />
    <button class="btn btn-primary" data-testid="search-button" @onclick="SearchAsync">Search</button>
</div>

@if (_error is not null)
{
    <div class="alert alert-warning" role="alert">@_error</div>
}

@if (_loading)
{
    <p><em>Loading…</em></p>
}
else if (_response is not null && _response.Total == 0)
{
    <p class="text-body-secondary">No log entries match the current filters.</p>
}
else if (_response is not null)
{
    <div class="row">
        <div class="col-md-9">
            <p class="text-body-secondary">@_response.Total results (page @_page)</p>
            <table class="table table-sm">
                <thead>
                    <tr><th>Timestamp</th><th>Level</th><th>Service</th><th>Message</th><th>Trace</th></tr>
                </thead>
                <tbody>
                    @foreach (var hit in _response.Hits)
                    {
                        <tr data-testid="result-row">
                            <td>@hit.Timestamp.ToString("HH:mm:ss.fff")</td>
                            <td><LevelBadge Level="@hit.Level" /></td>
                            <td>@hit.Service</td>
                            <td>
                                @if (hit.TraceId is not null)
                                {
                                    <a href="/trace/@hit.TraceId">@hit.Message</a>
                                }
                                else
                                {
                                    @hit.Message
                                }
                            </td>
                            <td class="font-monospace">@hit.TraceId</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="btn-group">
                <button class="btn btn-outline-secondary" disabled="@(_page <= 1)" @onclick="PrevPage">Prev</button>
                <button class="btn btn-outline-secondary" disabled="@(!HasMore)" @onclick="NextPage">Next</button>
            </div>
        </div>
        <div class="col-md-3">
            <h6>Levels</h6>
            @foreach (var bucket in _response.Facets.Levels)
            {
                <button class="list-group-item list-group-item-action d-flex justify-content-between"
                        data-testid="facet-level" @onclick="() => ApplyLevel(bucket.Value)">
                    <span>@bucket.Value</span><span class="badge bg-secondary">@bucket.Count</span>
                </button>
            }
            <h6 class="mt-3">Services</h6>
            @foreach (var bucket in _response.Facets.Services)
            {
                <button class="list-group-item list-group-item-action d-flex justify-content-between"
                        data-testid="facet-service" @onclick="() => ApplyService(bucket.Value)">
                    <span>@bucket.Value</span><span class="badge bg-secondary">@bucket.Count</span>
                </button>
            }
        </div>
    </div>
}

@code {
    private const int PageSize = 20;
    private static readonly string[] Levels =
        ["Trace", "Debug", "Information", "Warning", "Error", "Critical"];

    private string _q = "";
    private string _level = "";
    private string _service = "";
    private int _page = 1;
    private bool _loading;
    private string? _error;
    private SearchResponse? _response;

    private bool HasMore => _response is not null && _page * PageSize < _response.Total;

    protected override async Task OnInitializedAsync() => await SearchAsync();

    private async Task SearchAsync()
    {
        _loading = true;
        try
        {
            _response = await Client.SearchAsync(
                string.IsNullOrWhiteSpace(_q) ? null : _q,
                string.IsNullOrWhiteSpace(_level) ? null : _level,
                string.IsNullOrWhiteSpace(_service) ? null : _service,
                _page, PageSize);
            _error = null;
        }
        catch (LogPipeApiException ex)
        {
            _response = new SearchResponse(0, [], new([], []));
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") { _page = 1; await SearchAsync(); }
    }

    private async Task ApplyLevel(string level)
    {
        _level = level; _page = 1; await SearchAsync();
    }

    private async Task ApplyService(string service)
    {
        _service = service; _page = 1; await SearchAsync();
    }

    private async Task NextPage() { _page++; await SearchAsync(); }
    private async Task PrevPage() { if (_page > 1) { _page--; await SearchAsync(); } }
}
